{
  "name": "Graph Theory in Lean",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "onCreateCommand": "elan toolchain install \"$(cat lean-toolchain)\"",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ]
    }
  }
}
